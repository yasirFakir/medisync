{
  "name": "medisync-ai",
  "version": "1.0.0",
  "private": true,
  "description": "MediSync AI - AI-Powered Triage Chatbot, Prescription Digitizer, EHR & Pharmacy Portal",
  "scripts": {
    "dev": "npx pnpm --filter @medisync/web-portals dev",
    "dev:backend": "npx pnpm --filter @medisync/backend dev",
    "dev:ai": "cd apps/ai-service && python main.py",
    "dev:all": "npx turbo run dev",
    "run:win": ".\\run.bat",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js seed.sql",
    "db:seed:drugs": "node database/seed.js seed.sql && node database/seed.js drugs_seed.sql",
    "db:migrate:drugs": "node database/seed.js ../apps/backend/prisma/migrations/20260726_task003_medicine_database/migration.sql",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
